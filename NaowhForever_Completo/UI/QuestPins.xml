    <Button name="NaowhForeverQuestGiverPinTemplate" mixin="NaowhForeverQuestGiverPinMixin" enableMouse="true" virtual="true">
        <Size x="18" y="18"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon" setAllPoints="true"/>
            </Layer>
        </Layers>
        <Scripts><OnClick method="OnClick"/></Scripts>
    </Button>
</Ui>
