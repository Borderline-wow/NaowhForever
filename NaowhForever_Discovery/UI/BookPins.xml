<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- BookPins.xml: the library book pin's template, and the file that fills it. -->
    <Script file="BookPins.lua"/>
    <Button name="NaowhForeverLibraryPinTemplate" mixin="NaowhForeverLibraryPinMixin" enableMouse="true" virtual="true">
        <Size x="18" y="18"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Border">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="-1" y="1"/>
                        <Anchor point="BOTTOMRIGHT" x="1" y="-1"/>
                    </Anchors>
                    <Color r="0" g="0" b="0" a="1"/>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon" setAllPoints="true"/>
            </Layer>
        </Layers>
        <Scripts><OnClick method="OnClick"/></Scripts>
    </Button>
</Ui>
