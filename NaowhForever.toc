## Interface: 120000, 120001, 120005, 120007, 120100, 16001
## Title: |cff0091edNaowh|r Forever
## Notes: Naowh's Forever companion: Smart Reminders, QoL, macros and buff reminders.
## Author: NaowhUI
## Version: 0.5.0-beta
## OptionalDeps: NaowhUI_Media, BigWigs, DBM-Core
## SavedVariables: NaowhForeverDB, NaowhUI_SmartRemindersDB
## Group: NaowhUI
## IconTexture: Interface\AddOns\NaowhForever\Media\LogoAddon.tga
## AddonCompartmentFunc: NaowhForever_OnCompartmentClick

Libs\embeds.xml

# Locale tables must load before Core creates the addon namespace.
Locales\enUS.lua
Locales\deDE.lua [AllowLoadTextLocale deDE]
Locales\ruRU.lua [AllowLoadTextLocale ruRU]

# Core first: theme, chrome primitives, the DB and profiles -- everything later files
# hang off.
NaowhForever_Core.lua

# The widget kit: ns.UI, the shim every options page calls in place of EllesmereUI's
# factory. Needs ns.THEME and the Core primitives.
NaowhForever_Widgets.lua

# The standalone options window: tabs, scroll, RefreshPage, slash/compartment entry.
# The page builders it dispatches to live in the later files, resolved at open time.
NaowhForever_Window.lua

# Tank busters Blizzard's own TankRole bit does not carry. Additive to it, never a
# replacement, so content this file has never heard of still works unchanged. Loads after
# Core, which owns the namespace it hangs off.
NaowhForever_Abilities.lua

NaowhForever_SmartReminders.lua

# Raid-wide external/CD reminders, assignable to a role/class/spec/name/subgroup rather
# than the local player only -- built on the same BigWigs/DBM bar bridge the main file
# already runs for tank busters (ns.ScheduleBWFire), not a second one. Loads after the
# main file, which owns that bridge and the per-boss-set helper this hangs off.
NaowhForever_RaidReminders.lua

# Shareable Reminder Packs: a curator's lists, priorities and written reminders as
# one string, with preview-before-apply. Loads after the runtime it packages.
NaowhForever_Integrations.lua
NaowhForever_IntegrationOptions.lua
# Signature check for naowh.gg's personalized pack downloads. Loads before Packs,
# which calls into it; standalone otherwise, so load order relative to the main
# runtime does not matter.
NaowhForever_Verify.lua

NaowhForever_Packs.lua

# Reads this season's bosses and their tank-flagged abilities out of the player's own
# Dungeon Journal. Lazy: nothing is read until the page is opened.
NaowhForever_Bosses.lua

# What the boss actually did, recorded from the player's own pulls. Loads after the main
# file, whose dispatchers call into it and whose pull clocks it reads.
NaowhForever_Observed.lua

# The Custom Reminders tab and the MRT note format behind it. Loads last: the page
# renders through the shared section builder and editors Bosses.lua defines.
NaowhForever_Note.lua

# The Naowh Forever modules and the Patch Notes page. Page builders only, resolved by
# the window at open time.
NaowhForever_QoL.lua
NaowhForever_LootFeed.lua
NaowhForever_XPTicker.lua
NaowhForever_Restock.lua
NaowhForever_DungeonQuestData.lua
NaowhForever_DungeonQuests.lua
NaowhForever_TownData.lua
NaowhForever_TownMap.xml
NaowhForever_GearSets.lua
NaowhForever_BiS.lua
NaowhForever_Blessings.xml
NaowhForever_Blessings.lua
NaowhForever_BlessingsPage.lua
NaowhForever_Trainer.lua
NaowhForever_FlightData.lua
NaowhForever_Flight.lua
NaowhForever_QuizData.lua
NaowhForever_Quiz.lua
NaowhForever_Macros.lua
NaowhForever_AuraBuffs.lua
NaowhForever_Campfire.lua
NaowhForever_LowHealth.lua
NaowhForever_PatchNotes.lua
